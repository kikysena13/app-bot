    "dev:frontend": "npm --prefix frontend run start",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend exec tsc -- --noEmit",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test"
  },
